<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS system-wide and trust ONLY verified Android System CAs -->
    <!-- Rejects user-installed / rogue root certificates to prevent TLS interception -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
